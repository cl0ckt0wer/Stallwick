@page "/nearby"
@using Stallwick.Services
@inject ListingService Listings
@inject IJSRuntime JS

<PageTitle>Nearby listings</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Nearby listings</MudText>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-4">
    Listings ordered by distance from where you are.
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.MyLocation"
               Disabled="isLoading" OnClick="UseMyLocationAsync">
        Use my location
    </MudButton>

    <MudGrid Class="mt-2" Spacing="2">
        <MudItem xs="12" sm="4">
            <MudNumericField T="double" Label="Latitude" @bind-Value="latitude" Variant="Variant.Outlined"
                             HideSpinButtons="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="double" Label="Longitude" @bind-Value="longitude" Variant="Variant.Outlined"
                             HideSpinButtons="true" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="isLoading" OnClick="LoadAsync">
                Search here
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (error is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">@error</MudAlert>
}

@if (isLoading)
{
    <div class="d-flex align-center gap-2">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
        <MudText Typo="Typo.body2">Finding listings near you…</MudText>
    </div>
}
else if (results is not null)
{
    @if (results.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No listings anywhere yet. <MudLink Href="sell">Post one.</MudLink>
        </MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var result in results)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <ListingCard Listing="result.Listing" DistanceKm="result.DistanceKm" />
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private double latitude;
    private double longitude;
    private bool isLoading;
    private string? error;
    private List<NearbyListing>? results;

    private async Task UseMyLocationAsync()
    {
        error = null;
        isLoading = true;
        try
        {
            var position = await JS.InvokeAsync<GeolocationPosition>("stallwickGeolocation.getCurrentPosition");
            latitude = position.Latitude;
            longitude = position.Longitude;
        }
        catch (JSException ex)
        {
            error = $"Could not read your location ({ex.Message}). Enter coordinates manually instead.";
            isLoading = false;
            return;
        }

        isLoading = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        error = null;
        isLoading = true;
        try
        {
            results = await Listings.GetNearbyAsync(latitude, longitude);
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed record GeolocationPosition(double Latitude, double Longitude);
}
