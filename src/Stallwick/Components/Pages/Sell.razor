@page "/sell"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Stallwick.Data
@using Stallwick.Services
@inject ListingService Listings
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Post something for sale</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Post something for sale</MudText>

<MudPaper Class="pa-6" Elevation="1" Style="max-width: 40rem;">
    <EditForm Model="input" OnValidSubmit="SubmitAsync" FormName="post-listing">
        <DataAnnotationsValidator />

        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudTextField Label="Title" @bind-Value="input.Title" For="@(() => input.Title)"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="Description" @bind-Value="input.Description" For="@(() => input.Description)"
                              Variant="Variant.Outlined" Lines="4" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" Label="Price" @bind-Value="input.Price" For="@(() => input.Price)"
                                 Variant="Variant.Outlined" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Photo URL" @bind-Value="input.ImageUrl" For="@(() => input.ImageUrl)"
                              Variant="Variant.Outlined" Placeholder="https://…" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="Location name" @bind-Value="input.LocationName"
                              For="@(() => input.LocationName)" Variant="Variant.Outlined"
                              Placeholder="Portland, OR" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="double" Label="Latitude" @bind-Value="input.Latitude"
                                 For="@(() => input.Latitude)" Variant="Variant.Outlined"
                                 HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="double" Label="Longitude" @bind-Value="input.Longitude"
                                 For="@(() => input.Longitude)" Variant="Variant.Outlined"
                                 HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.MyLocation" OnClick="UseMyLocationAsync">
                    Use my location
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4">@error</MudAlert>
        }

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6"
                   Disabled="isSaving"
                   StartIcon="@(isSaving ? null : Icons.Material.Filled.AddCircle)">
            @if (isSaving)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
            }
            Post listing
        </MudButton>
    </EditForm>
</MudPaper>

@code {
    private Listing input = new();
    private bool isSaving;
    private string? error;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private async Task UseMyLocationAsync()
    {
        error = null;
        try
        {
            var position = await JS.InvokeAsync<GeolocationPosition>("stallwickGeolocation.getCurrentPosition");
            input.Latitude = position.Latitude;
            input.Longitude = position.Longitude;
        }
        catch (JSException ex)
        {
            error = $"Could not read your location ({ex.Message}). Enter coordinates manually instead.";
        }
    }

    private async Task SubmitAsync()
    {
        if (AuthenticationState is null || isSaving)
        {
            return;
        }

        var state = await AuthenticationState;
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            error = "You need to be signed in to post a listing.";
            return;
        }

        isSaving = true;
        try
        {
            input.SellerId = user.Id;
            await Listings.CreateAsync(input);
            // A saved entity already has an Id, so resubmitting it would collide.
            input = new Listing();
            Navigation.NavigateTo("browse");
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed record GeolocationPosition(double Latitude, double Longitude);
}
