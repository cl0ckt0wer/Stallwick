@page "/browse"
@using Stallwick.Data
@using Stallwick.Services
@inject ListingService Listings

<PageTitle>Browse listings</PageTitle>

<h1>Browse listings</h1>
<p class="lead">Everything for sale, newest first.</p>

@if (listings is null)
{
    <p><em>Loading listings…</em></p>
}
else if (listings.Count == 0)
{
    <p>
        No listings yet. <a href="sell">Post the first one.</a>
    </p>
}
else
{
    <div class="listing-grid">
        @foreach (var listing in listings)
        {
            <ListingCard Listing="listing" />
        }
    </div>
}

@code {
    private List<Listing>? listings;

    protected override async Task OnInitializedAsync()
    {
        listings = await Listings.GetRecentAsync();
    }
}
