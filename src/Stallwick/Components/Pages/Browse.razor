@page "/browse"
@using Stallwick.Data
@using Stallwick.Services
@inject ListingService Listings

<PageTitle>Browse listings</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Browse listings</MudText>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-4">Everything for sale, newest first.</MudText>

@if (listings is null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (listings.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No listings yet. <MudLink Href="sell">Post the first one.</MudLink>
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var listing in listings)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <ListingCard Listing="listing" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Listing>? listings;

    protected override async Task OnInitializedAsync()
    {
        listings = await Listings.GetRecentAsync();
    }
}
