@page "/"
@using Stallwick.Data
@using Stallwick.Services
@inject ListingService Listings

<PageTitle>Stallwick</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Stallwick</MudText>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    Post your stuff for sale. Find what people are selling around you.
</MudText>

<div class="d-flex gap-2 flex-wrap my-4">
    <MudButton Href="sell" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.AddCircle">
        Post a listing
    </MudButton>
    <MudButton Href="nearby" Variant="Variant.Outlined" Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.NearMe">
        See what's nearby
    </MudButton>
</div>

<MudText Typo="Typo.h5" GutterBottom="true">Latest listings</MudText>

@if (listings is null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (listings.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No listings yet. <MudLink Href="sell">Post the first one.</MudLink>
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var listing in listings)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <ListingCard Listing="listing" />
            </MudItem>
        }
    </MudGrid>
    <MudButton Href="browse" Variant="Variant.Text" Color="Color.Primary" Class="mt-4"
               EndIcon="@Icons.Material.Filled.ArrowForward">
        Browse all listings
    </MudButton>
}

@code {
    private List<Listing>? listings;

    protected override async Task OnInitializedAsync()
    {
        listings = await Listings.GetRecentAsync(take: 12);
    }
}
