@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="StallwickTheme.Theme" IsDarkMode="isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Navigation menu" OnClick="ToggleDrawer" />
        <MudLink Href="" Typo="Typo.h6" Color="Color.Inherit" Underline="Underline.None" Class="ml-2">Stallwick</MudLink>
        <MudSpacer />
        <MudIconButton Icon="@(isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" aria-label="Toggle dark mode" OnClick="ToggleDarkMode" />
        <AuthorizeView>
            <Authorized>
                <MudButton Href="Account/Manage" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.AccountCircle">
                    @context.User.Identity?.Name
                </MudButton>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Inherit">Logout</MudButton>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="Account/Login" Color="Color.Inherit">Log in</MudButton>
                <MudButton Href="Account/Register" Variant="Variant.Filled" Color="Color.Secondary">Sign up</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="isDrawerOpen" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Docked"
               Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string currentUrl = default!;
    private bool isDrawerOpen = true;
    private bool isDarkMode;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    }

    private void ToggleDrawer() => isDrawerOpen = !isDrawerOpen;

    private void ToggleDarkMode() => isDarkMode = !isDarkMode;
}
