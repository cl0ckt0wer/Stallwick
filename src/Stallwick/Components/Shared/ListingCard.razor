@using Stallwick.Data

<MudCard Elevation="1" Class="d-flex flex-column" Style="height: 100%;">
    @if (!string.IsNullOrWhiteSpace(Listing.ImageUrl))
    {
        <MudCardMedia Image="@Listing.ImageUrl" Height="160" title="@Listing.Title" />
    }
    else
    {
        <MudPaper Elevation="0" Square="true"
                  Class="d-flex align-center justify-center"
                  Style="height: 160px; background: var(--mud-palette-background-gray);">
            <MudText Typo="Typo.caption">No photo</MudText>
        </MudPaper>
    }
    <MudCardContent>
        <MudText Typo="Typo.subtitle1">@Listing.Title</MudText>
        <MudText Typo="Typo.h6" Color="Color.Primary">@Listing.Price.ToString("C")</MudText>
        <div class="d-flex align-center gap-1 flex-wrap mt-1">
            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Place" Variant="Variant.Text">
                @Listing.LocationName
            </MudChip>
            @if (DistanceKm is not null)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                    @DistanceKm.Value.ToString("0.#") km away
                </MudChip>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Listing.Description))
        {
            <MudText Typo="Typo.body2" Class="mt-2 listing-card-description">@Listing.Description</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public Listing Listing { get; set; } = default!;

    [Parameter]
    public double? DistanceKm { get; set; }
}
